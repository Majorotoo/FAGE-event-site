'use client';

import { useEffect, useMemo, useState } from 'react';
import { useRouter } from 'next/navigation';
import { Archive, Download, Eye, EyeOff, LogOut, Search, ShieldCheck, Trash2 } from 'lucide-react';

interface EventConfig {
  eventName: string;
  logoUrl: string;
  themeColor: string;
  registrationOpen: boolean;
  lastUpdated: string;
}

interface Participant {
  id: string;
  firstName: string;
  surname: string;
  telephone: string;
  email: string;
  association: string;
  createdAt: string;
}

interface ArchivedEvent {
  id: string;
  eventName: string;
  logoUrl: string;
  archivedAt: string;
  participants: Participant[];
}

export default function AdminDashboardPage() {
  const router = useRouter();
  const [eventConfig, setEventConfig] = useState<EventConfig>({
    eventName: 'FAGE Event',
    logoUrl: '/FAGE%20Logos-02.png',
    themeColor: '#0f172a',
    registrationOpen: false,
    lastUpdated: new Date().toISOString(),
  });
  const [participants, setParticipants] = useState<Participant[]>([]);
  const [archives, setArchives] = useState<ArchivedEvent[]>([]);
  const [searchTerm, setSearchTerm] = useState('');
  const [isLoading, setIsLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);
  const [isArchiving, setIsArchiving] = useState(false);

  const fetchDashboardData = async () => {
    try {
      const response = await fetch('/api/admin/event');

      if (response.status === 401) {
        router.push('/admin/login');
        return;
      }

      if (!response.ok) {
        throw new Error('Unable to load dashboard data');
      }

      const payload = await response.json();
      setEventConfig(payload.config ?? {
        eventName: 'FAGE Event',
        logoUrl: '/FAGE%20Logos-02.png',
        themeColor: '#0f172a',
        registrationOpen: false,
        lastUpdated: new Date().toISOString(),
      });
      setParticipants(payload.participants ?? []);
      setArchives(payload.archives ?? []);
    } catch (error) {
      console.error(error);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, [router]);

  const filteredParticipants = useMemo(() => {
    const term = searchTerm.trim().toLowerCase();
    if (!term) return participants;

    return participants.filter((person) => {
      const values = [
        person.firstName,
        person.surname,
        person.telephone,
        person.email,
        person.association,
      ].join(' ').toLowerCase();

      return values.includes(term);
    });
  }, [participants, searchTerm]);

  const saveEventConfig = async (update: Partial<EventConfig>) => {
    setIsSaving(true);

    try {
      const response = await fetch('/api/admin/event', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(update),
      });

      if (!response.ok) {
        throw new Error('Unable to save event settings');
      }

      const payload = await response.json();
      setEventConfig(payload.config);
      await fetchDashboardData();
    } finally {
      setIsSaving(false);
    }
  };

  const handleOpenOrClose = async () => {
    await saveEventConfig({ registrationOpen: !eventConfig.registrationOpen });
  };

  const handleArchive = async () => {
    setIsArchiving(true);

    try {
      const response = await fetch('/api/admin/archive', { method: 'POST' });
      if (!response.ok) {
        throw new Error('Unable to archive registrations');
      }

      const payload = await response.json();
      setParticipants([]);
      setArchives((current) => [payload.archive, ...current]);
    } finally {
      setIsArchiving(false);
    }
  };

  const handleDelete = async (id: string) => {
    const nextParticipants = participants.filter((person) => person.id !== id);
    setParticipants(nextParticipants);
    await fetch('/api/admin/event', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ eventName: eventConfig.eventName, logoUrl: eventConfig.logoUrl, themeColor: eventConfig.themeColor, registrationOpen: eventConfig.registrationOpen }),
    });
  };

  const handleExport = () => {
    if (!participants.length) return;

    const csvRows = [
      ['First Name', 'Surname', 'Telephone', 'Email', 'Association', 'Submitted At'],
      ...participants.map((item) => [
        item.firstName,
        item.surname,
        item.telephone,
        item.email,
        item.association,
        item.createdAt,
      ]),
    ];

    const csv = csvRows.map((row) => row.map((value) => `"${String(value).replace(/"/g, '""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `${eventConfig.eventName.replace(/\s+/g, '-').toLowerCase()}-registrations.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  };

  const handleLogout = async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    router.push('/admin/login');
  };

  if (isLoading) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-950 text-slate-100">
        <div className="text-center">
          <div className="mx-auto mb-4 h-12 w-12 animate-spin rounded-full border-4 border-slate-700 border-t-emerald-500" />
          <p className="text-slate-400">Loading dashboard...</p>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-950 text-white">
      <div className="mx-auto max-w-7xl px-6 py-8">
        <header className="mb-8 flex flex-col gap-5 rounded-3xl border border-slate-800 bg-slate-900/80 p-5 shadow-2xl shadow-slate-950/30 md:flex-row md:items-center md:justify-between">
          <div className="flex items-center gap-4">
            <img src={eventConfig.logoUrl || '/FAGE%20Logos-02.png'} alt={eventConfig.eventName} className="h-14 w-14 rounded-2xl border border-slate-700 object-cover" />
            <div>
              <p className="text-xs uppercase tracking-[0.2em] text-slate-400">Event management</p>
              <h1 className="text-2xl font-bold">{eventConfig.eventName}</h1>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-3">
            <button
              onClick={handleOpenOrClose}
              disabled={isSaving}
              className="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-white transition"
              style={{ backgroundColor: eventConfig.registrationOpen ? '#ef4444' : '#10b981' }}
            >
              {eventConfig.registrationOpen ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
              {eventConfig.registrationOpen ? 'Close link' : 'Open link'}
            </button>

            <button
              onClick={handleArchive}
              disabled={isArchiving || participants.length === 0}
              className="inline-flex items-center gap-2 rounded-xl bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-100 transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <Archive className="h-4 w-4" />
              {isArchiving ? 'Archiving...' : 'Archive'}
            </button>

            <button
              onClick={handleExport}
              disabled={participants.length === 0}
              className="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <Download className="h-4 w-4" />
              Export CSV
            </button>

            <button
              onClick={handleLogout}
              className="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-500"
            >
              <LogOut className="h-4 w-4" />
              Logout
            </button>
          </div>
        </header>

        <section className="mb-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <div className="rounded-3xl border border-slate-800 bg-slate-900/80 p-6">
            <div className="mb-5 flex items-center gap-3">
              <div className="rounded-2xl p-2 text-white" style={{ backgroundColor: eventConfig.themeColor }}>
                <ShieldCheck className="h-5 w-5" />
              </div>
              <div>
                <p className="text-xs uppercase tracking-[0.2em] text-slate-400">Branding</p>
                <h2 className="text-xl font-bold">Registration appearance</h2>
              </div>
            </div>

            <div className="space-y-4">
              <div>
                <label className="mb-2 block text-sm font-medium text-slate-300">Event name</label>
                <input
                  value={eventConfig.eventName}
                  onChange={(event) => setEventConfig((current) => ({ ...current, eventName: event.target.value }))}
                  className="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm text-white outline-none transition focus:border-emerald-500"
                />
              </div>

              <div>
                <label className="mb-2 block text-sm font-medium text-slate-300">Logo URL</label>
                <input
                  value={eventConfig.logoUrl}
                  onChange={(event) => setEventConfig((current) => ({ ...current, logoUrl: event.target.value }))}
                  className="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm text-white outline-none transition focus:border-emerald-500"
                />
              </div>

              <div>
                <label className="mb-2 block text-sm font-medium text-slate-300">Theme color</label>
                <div className="flex items-center gap-3">
                  <input
                    type="color"
                    value={eventConfig.themeColor}
                    onChange={(event) => setEventConfig((current) => ({ ...current, themeColor: event.target.value }))}
                    className="h-12 w-20 cursor-pointer rounded-lg border border-slate-700 bg-slate-950"
                  />
                  <span className="rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-300">{eventConfig.themeColor}</span>
                </div>
              </div>

              <button
                onClick={() => saveEventConfig(eventConfig)}
                disabled={isSaving}
                className="w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-500 disabled:cursor-not-allowed disabled:opacity-40"
              >
                {isSaving ? 'Saving brand settings...' : 'Save branding'}
              </button>
            </div>
          </div>

          <div className="rounded-3xl border border-slate-800 bg-slate-900/80 p-6">
            <p className="text-xs uppercase tracking-[0.2em] text-slate-400">Live status</p>
            <div className="mt-4 flex items-center justify-between rounded-2xl border border-slate-800 bg-slate-950 p-4">
              <div>
                <p className="text-sm text-slate-400">Registration link</p>
                <p className="text-xl font-bold text-white">{eventConfig.registrationOpen ? 'Open' : 'Closed'}</p>
              </div>
              <div className={`h-4 w-4 rounded-full ${eventConfig.registrationOpen ? 'bg-emerald-500' : 'bg-rose-500'}`} />
            </div>

            <div className="mt-6 rounded-2xl border border-slate-800 bg-slate-950 p-4 text-sm text-slate-300">
              <p className="font-medium text-white">Public link</p>
              <p className="mt-2 break-all text-slate-400">{typeof window !== 'undefined' ? `${window.location.origin}/` : '/'}</p>
            </div>
          </div>
        </section>

        <section className="rounded-3xl border border-slate-800 bg-slate-900/80 overflow-hidden">
          <div className="flex items-center justify-between border-b border-slate-800 bg-slate-950/60 px-6 py-4">
            <div>
              <p className="text-xs uppercase tracking-[0.2em] text-slate-400">Registered entries</p>
              <h2 className="text-xl font-bold">{eventConfig.registrationOpen ? 'Registration active' : 'Closed event list'}</h2>
            </div>
            <span className="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs font-medium text-slate-300">
              {participants.length} entries
            </span>
          </div>

          {!eventConfig.registrationOpen ? (
            <>
              <div className="border-b border-slate-800 p-4">
                <div className="relative">
                  <Search className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" />
                  <input
                    value={searchTerm}
                    onChange={(event) => setSearchTerm(event.target.value)}
                    placeholder="Search by name, phone, email or association"
                    className="w-full rounded-xl border border-slate-700 bg-slate-950 py-3 pl-11 pr-4 text-sm text-white outline-none transition focus:border-emerald-500"
                  />
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm text-slate-300">
                  <thead className="bg-slate-950/80 text-xs uppercase tracking-wider text-slate-400">
                    <tr>
                      <th className="px-6 py-4">Name</th>
                      <th className="px-6 py-4">Contact</th>
                      <th className="px-6 py-4">Association</th>
                      <th className="px-6 py-4">Submitted</th>
                      <th className="px-6 py-4 text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredParticipants.length === 0 ? (
                      <tr>
                        <td colSpan={5} className="px-6 py-12 text-center text-slate-500">
                          No registrations found for this event.
                        </td>
                      </tr>
                    ) : (
                      filteredParticipants.map((person) => (
                        <tr key={person.id} className="border-t border-slate-800 hover:bg-slate-800/20">
                          <td className="px-6 py-4">
                            <p className="font-semibold text-white">{person.firstName} {person.surname}</p>
                          </td>
                          <td className="px-6 py-4">
                            <p>{person.telephone}</p>
                            <p className="text-xs text-slate-500">{person.email}</p>
                          </td>
                          <td className="px-6 py-4">{person.association}</td>
                          <td className="px-6 py-4">{new Date(person.createdAt).toLocaleString()}</td>
                          <td className="px-6 py-4 text-right">
                            <button
                              onClick={() => handleDelete(person.id)}
                              className="rounded-lg bg-slate-800 p-2 text-slate-300 transition hover:bg-rose-600 hover:text-white"
                              aria-label="Delete participant"
                            >
                              <Trash2 className="h-4 w-4" />
                            </button>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </>
          ) : (
            <div className="p-8 text-center text-slate-400">
              Registrations are being collected live. The full participant list is hidden until the registration link is closed.
            </div>
          )}
        </section>

        {archives.length > 0 && (
          <section className="mt-8 rounded-3xl border border-slate-800 bg-slate-900/80 p-5">
            <div className="mb-4 flex items-center justify-between">
              <h3 className="text-xl font-bold text-white">Archived events</h3>
              <span className="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-xs text-slate-300">{archives.length} archives</span>
            </div>

            <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {archives.map((archive) => (
                <div key={archive.id} className="rounded-2xl border border-slate-800 bg-slate-950/60 p-4">
                  <div className="mb-3 flex items-center gap-3">
                    <img src={archive.logoUrl || '/FAGE%20Logos-02.png'} alt={archive.eventName} className="h-10 w-10 rounded-xl object-cover" />
                    <div>
                      <p className="font-semibold text-white">{archive.eventName}</p>
                      <p className="text-xs text-slate-400">{new Date(archive.archivedAt).toLocaleString()}</p>
                    </div>
                  </div>
                  <p className="text-sm text-slate-300">{archive.participants.length} registrations archived</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </main>
  );
}
